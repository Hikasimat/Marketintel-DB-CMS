# -----------------------------------------------------------------------------
# Configuration Reference (.env.example)
# Copy to .env for local overrides. NEVER commit real secrets or production keys.
# -----------------------------------------------------------------------------

# Profile selection: cms.settings.dev, cms.settings.test, cms.settings.prod
DJANGO_SETTINGS_MODULE=cms.settings.dev

# Core Security
# Production requires a cryptographically random string (min 50 chars)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-50-character-string-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# Database Configuration (PostgreSQL 16+)
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# Redis & Celery Cache / Broker
REDIS_URL=redis://localhost:56379/0
CELERY_BROKER_URL=redis://localhost:56379/0
CELERY_RESULT_BACKEND=redis://localhost:56379/0

# Envelope Encryption (Master Key / KEK)
# 64-character hex-encoded string representing a 256-bit AES key
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_FALLBACK_KEYS=

# External Token Issuer (MarketIntel Federated Identity Adapter)
AUTH_EXTERNAL_ISSUER_ENABLED=false
AUTH_EXTERNAL_ISSUER_NAME=https://auth.marketintel.internal
AUTH_EXTERNAL_AUDIENCE=cms-backend-api
AUTH_EXTERNAL_ISSUER_PUBLIC_KEY=

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging & Observability
LOG_LEVEL=INFO
LOG_JSON=false

# Rate Limiting (DRF Throttles)
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
THROTTLE_PUBLIC_DELIVERY_RATE=1200/min
THROTTLE_EVENT_INGEST_RATE=3000/min
THROTTLE_OAUTH_RATE=30/min
THROTTLE_REPORTS_RATE=120/min
THROTTLE_INDEXING_RATE=60/min

# Search & Analytics Integrations (Credentials & OAuth)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

BING_CLIENT_ID=
BING_CLIENT_SECRET=
BING_REDIRECT_URI=http://localhost:8000/api/v1/integrations/bing/callback

INDEXNOW_API_KEY=

GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REDIRECT_URI=http://localhost:8000/api/v1/analytics/google/callback

# GitHub App Integration (Feature-Flagged)
GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Feature Flags
ADMIN_ENABLED=false
API_DOCS_ENABLED=true
