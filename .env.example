# -----------------------------------------------------------------------------
# Configuration Reference (.env.example)
# Copy to .env for local overrides. NEVER commit real secrets or production keys.
# -----------------------------------------------------------------------------

# Profile selection: dev, test, prod
DJANGO_SETTINGS_MODULE=cms.settings.dev

# Core Security (Production requires min 50 characters)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-50-character-string-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PUBLIC_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL only)
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# Redis & Celery Cache / Broker
REDIS_URL=redis://localhost:56379/0

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Rate Limiting
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min

# Feature Flags
ADMIN_ENABLED=false
API_DOCS_ENABLED=true
