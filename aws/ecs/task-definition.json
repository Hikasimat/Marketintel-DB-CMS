{
  "family": "marketintel-cms-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/marketintel-cms-task-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/marketintel-cms-task-role",
  "containerDefinitions": [
    {
      "name": "cms-backend",
      "image": "ACCOUNT_ID.dkr.ecr.AWS_REGION.amazonaws.com/marketintel-db-cms:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SETTINGS_PROFILE",
          "value": "prod"
        },
        {
          "name": "DJANGO_SETTINGS_MODULE",
          "value": "cms.settings.prod"
        },
        {
          "name": "AUTO_MIGRATE",
          "value": "true"
        },
        {
          "name": "AUTO_COLLECTSTATIC",
          "value": "true"
        },
        {
          "name": "TRUST_X_FORWARDED_PROTO",
          "value": "true"
        },
        {
          "name": "MARKET_INTEL_LOGIN_URL",
          "value": "https://marketinteldbapp.hikasimat.com/api/auth/login/"
        }
      ],
      "secrets": [
        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/DJANGO_SECRET_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/DATABASE_URL"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/REDIS_URL"
        },
        {
          "name": "FIELD_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/FIELD_ENCRYPTION_KEY"
        },
        {
          "name": "JWT_SIGNING_KEY",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/JWT_SIGNING_KEY"
        },
        {
          "name": "PUBLIC_BASE_URL",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/PUBLIC_BASE_URL"
        },
        {
          "name": "DJANGO_ALLOWED_HOSTS",
          "valueFrom": "arn:aws:ssm:AWS_REGION:ACCOUNT_ID:parameter/marketintel-cms/DJANGO_ALLOWED_HOSTS"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/marketintel-cms-backend",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/api/v1/health/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
