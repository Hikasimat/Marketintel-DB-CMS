{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": [
            "sts.amazonaws.com",
            "https://github.com/Hikasimat",
            "https://github.com/Mohanraj02V"
          ]
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:Hikasimat/*",
            "repo:hikasimat/*",
            "repo:Mohanraj02V/*",
            "repo:mohanraj02v/*"
          ]
        }
      }
    }
  ]
}
